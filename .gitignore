data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.tif
*.tiff
*.jp2
*.nc
*.zarr/
*.grib
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.geojson
*.parquet
