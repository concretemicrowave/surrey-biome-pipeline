% --- City of Surrey EMS / Green Infrastructure Network (Section 1.1) --------
%  VERIFIED 2026-07-30 from the document itself. The server returns HTTP 403 to
%  a plain automated fetch but serves the file to a normal browser user-agent.
%  Title page: "City of Surrey Ecosystem Management Study / Book 1. Main Report
%  / April 2011", with the HB Lanarc and Raincoast logos; the credits name the
%  project team as HB Lanarc and Raincoast Applied Ecology. Section 2.3
%  "Delineation of the Green Infrastructure Network" describes the GIS method,
%  and reports 88 hubs, 803 sites and 396 corridor SEGMENTS -- not 144.
%
%  CORRECTED 2026-08-07 (KNOWN_ISSUES S2). This note previously said the 144
%  named corridors "come from Appendix J of the same document". They do not.
%  The EMS has no Appendix J: its table of contents reads "APPENDICES (see
%  Book 2)" and lists A (Vegetation Classes), B (Inventory Components),
%  C (Representative Vegetation Photos) and D (Map Catalogue), the string
%  "Appendix J" does not occur in its 79 pages, and neither does "144". The
%  appendix the pipeline parses belongs to surreyBCS below -- see that entry.
@techreport{surreyEMS,
  author      = {{City of Surrey}},
  title       = {{City of Surrey Ecosystem Management Study, Book 1: Main Report}},
  institution = {City of Surrey},
  address     = {Surrey, British Columbia, Canada},
  month       = apr,
  year        = {2011},
  url         = {https://www.surrey.ca/sites/default/files/media/documents/EcosystemManagementStudy.pdf},
  note        = {Prepared by HB Lanarc and Raincoast Applied Ecology}
}


% --- City of Surrey Biodiversity Conservation Strategy (Section 1.1) --------
%  VERIFIED 2026-08-07 from the document itself, resolving KNOWN_ISSUES S2.
%  Cover: "BIODIVERSITY CONSERVATION STRATEGY / PRODUCED BY DIAMOND HEAD
%  CONSULTING - JANUARY 2014"; the acknowledgments name Diamond Head Consulting
%  Ltd. (Michael Coulthard, J. Brett Allen) as lead consultant and primary
%  authors, with the City of Surrey as the commissioning body; PDF metadata
%  gives Author "City of Surrey". Running heads throughout read "Spring 2014 .
%  BCS", which is the form the parser matches on, so the document is cited by
%  year rather than by season.
%
%  This is where Appendix J lives. Its contents list an "Appendix J - Green
%  Infastructure Network Corridors" [sic, the source misspells Infrastructure],
%  printed pages 119-129, holding Table 33 "Inventory of corridors". Parsing
%  those pages out of the full report with scripts/parse_appendix_j.py's own
%  row pattern returns 144 corridors, ids 1-144, IDENTICAL on all four
%  attributes (risk of development, ecological value, corridor type, target
%  width) to the standalone Appendix_J.pdf the pipeline downloads: 144/144
%  matched, agreement 1.0000 on every field. The BCS itself states the division
%  of labour this paper now follows -- "Habitat hubs, sites and corridors ...
%  were initially identified in the EMS (2011). These components were further
%  assessed and prioritized in this Strategy" (p. 67) -- and cites the EMS in
%  its own reference list as HB Lanarc (2011). The City's open-data service
%  agrees: the corridor layer sits under group layer 0, named "Biodiversity
%  Conservation Strategy".
@techreport{surreyBCS,
  author      = {{City of Surrey}},
  title       = {{Biodiversity Conservation Strategy}},
  institution = {City of Surrey},
  address     = {Surrey, British Columbia, Canada},
  year        = {2014},
  url         = {https://www.surrey.ca/sites/default/files/media/documents/Surrey_BCS_Report.pdf},
  note        = {Prepared by Diamond Head Consulting Ltd.
                 Appendix~J, pp.~119--129, tabulates the 144 Green
                 Infrastructure Network corridors; also served separately as
                 \url{https://www.surrey.ca/sites/default/files/media/documents/Appendix_J.pdf}}
}


