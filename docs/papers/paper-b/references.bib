% --- City of Surrey open-data GIN layer (Section 1.1 footnote, Section 2.1) --
%  RESOLVED 2026-08-07, closing KNOWN_ISSUES S1. This is the record the
%  pipeline actually reads, and it has no DOI and no landing page of its own.
%  What was checked, so the next person does not repeat it: the service's
%  /legend endpoint names layer 1 "Green Infrastructure Network Corridors" and
%  places it under group layer 0 "Biodiversity Conservation Strategy"; the
%  layer's own metadata endpoint returns HTTP 500 and the service root carries
%  an empty serviceDescription and copyrightText, so there is no publisher
%  metadata to quote. The former catalogue host data.surrey.ca now 302s to the
%  ArcGIS Hub site, whose DCAT feed (225 datasets) publishes the polyline
%  "Ecosystem Corridors" layer but NOT this polygon layer -- so the service
%  endpoint, not a catalogue page, is the citable locator. Accessed date is the
%  date the corridors were pulled (data/raw/surrey/surrey_corridors.geojson).
@misc{surreyOpenData,
  author       = {{City of Surrey}},
  title        = {{Green Infrastructure Network Corridors (OpenData MapServer,
                  layer~1)}},
  howpublished = {City of Surrey Open Data, ArcGIS MapServer},
  year         = {2026},
  url          = {https://gisservices.surrey.ca/arcgis/rest/services/OpenData/MapServer},
  note         = {Accessed 21 July 2026. Catalogue:
